{
  "name": "mtg-library",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Magic: The Gathering collection, deck and trade manager",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
